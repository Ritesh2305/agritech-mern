# AgriTech Environment Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local: mongodb://localhost:27017/agritech)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agritech?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=agritech_jwt_secure_agricultural_secret_key_2026
JWT_EXPIRES_IN=7d

# Weather API (Optional OpenWeatherMap API key - fallback to realistic telemetry if absent)
OPENWEATHER_API_KEY=

# Frontend Mock Mode (Set to true to force browser local storage mock mode, or false for live Express/Mongo API)
VITE_USE_MOCK=false

# Google AI Studio injected variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
